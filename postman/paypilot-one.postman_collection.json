      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "PayPal Sandbox – Create Order (Authoritative Price)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"product_id\": \"prod_01\",\n      \"quantity\": 2\n    },\n    {\n      \"product_id\": \"prod_02\",\n      \"quantity\": 1\n    }\n  ],\n  \"source\": \"agentcart\",\n  \"customer\": {\n    \"name\": \"Sarah Chen\",\n    \"email\": \"sarah.chen@apexdigital.tech\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/paypal/create-order",
          "host": ["{{baseUrl}}"],
          "path": ["api", "paypal", "create-order"]
        }
      }
    },
    {
      "name": "PayPal Sandbox – Capture Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"PAYPAL-SB-1794135240170-1398\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/paypal/capture-order",
          "host": ["{{baseUrl}}"],
          "path": ["api", "paypal", "capture-order"]
        }
      }
    },
    {
      "name": "PayPal Sandbox – Webhook Idempotent Receiver",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "paypal-event-id", "value": "evt_sample_test_001" },
          { "key": "paypal-transmission-sig", "value": "mock_sig_sandbox" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"evt_sample_test_001\",\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource\": {\n    \"id\": \"PP-CAP-123\",\n    \"amount\": { \"value\": \"427.69\", \"currency_code\": \"USD\" }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/paypal/webhook",
          "host": ["{{baseUrl}}"],
          "path": ["api", "paypal", "webhook"]
        }
      }
    },
    {
      "name": "PayPal Sandbox – Webhook Event Log",
      "request": {
        "method": "GET",
        "header": [],
