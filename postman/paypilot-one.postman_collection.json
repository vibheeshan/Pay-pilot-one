{
  "info": {
    "_postman_id": "c1f78239-4981-4ba2-82ab-b19b841829e1",
    "name": "PayPilot One API Collection",
    "description": "Comprehensive Postman collection covering System Health, Multi-Agent Copilot, Authoritative PayPal Sandbox orders, Captures, Webhooks, and Invoice Overdue Checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
