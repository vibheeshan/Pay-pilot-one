# PayPilot One — Environment Variables Template
# Copy to .env (never commit .env to git).
# Variables prefixed VITE_ are embedded in the browser bundle at build time.
# All others are server-side only.

# Server
PORT=3000
NODE_ENV=production

# Groq AI (server-side only — NEVER use VITE_ prefix)
# Get your key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# App URL (used for CORS / callback if needed)
APP_URL=

# Supabase — VITE_ vars are intentionally public (anon key + RLS enforces security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key — SERVER-SIDE ONLY, never use VITE_ prefix
# Used only by server.ts for audit log writes and idempotent webhook inserts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PayPal Sandbox credentials — SERVER-SIDE ONLY
# CLIENT_ID and CLIENT_SECRET authenticate the Express server to PayPal REST API.
# WEBHOOK_ID is required for webhook signature verification.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PayPal Client ID is semi-public (used by the PayPal JS SDK in the browser if needed).
# Only expose via VITE_ if you add the PayPal JS button — do NOT expose the secret.
VITE_PAYPAL_CLIENT_ID=
